# SportAccess environment variables
# Copy this file to .env and fill in local values.

# Database
DB_URL=jdbc:mysql://localhost:3306/sportaccess?createDatabaseIfNotExist=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change_me

# Firebase Admin SDK
# Absolute path to the Firebase service account JSON file.
FIREBASE_CONFIG_PATH=C:/path/to/firebase-service-account.json

# CORS
# Allowed origins, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Optional logging
HIBERNATE_SQL_LOG_LEVEL=INFO

# Stripe (optional)
# STRIPE_API_KEY=sk_test_...
